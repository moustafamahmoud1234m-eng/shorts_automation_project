# ==========================================
# AWS PostgreSQL Database Configuration
# ==========================================
PG_HOST=your-rds-endpoint.amazonaws.com
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=your_database_password

# ==========================================
# Supabase Configuration (Storage / Fallback)
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SECRET_KEY=your_supabase_service_role_key

# ==========================================
# Meta / Social Tokens (Optional Reference)
# ==========================================
# FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
# INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# ==========================================
# Admin & Webhook Configuration
# ==========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/new-video-submission
