    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const inputItem of $input.all()) {\n  const metrics = inputItem.json.data || [];\n\n  let mediaId = '';\n  let views = 0;\n  let reach = 0;\n  let totalInteractions = 0;\n  let likes = 0;\n  let comments = 0;\n  let shares = 0;\n  let saved = 0;\n\n  for (const item of metrics) {\n    if (!mediaId && item.id) {\n      // Extracts the media ID from e.g. \"18182160208438909/insights/...\"\n      mediaId = item.id.split('/')[0];\n    }\n\n    const val = (item.values && item.values.length > 0) ? Number(item.values[0].value) || 0 : 0;\n\n    switch (item.name) {\n      case 'views':\n        views = val;\n        break;\n      case 'reach':\n        reach = val;\n        break;\n      case 'total_interactions':\n        totalInteractions = val;\n        break;\n      case 'likes':\n        likes = val;\n        break;\n      case 'comments':\n        comments = val;\n        break;\n      case 'shares':\n        shares = val;\n        break;\n      case 'saved':\n        saved = val;\n        break;\n    }\n  }\n\n  results.push({\n    json: {\n      media_id: mediaId,\n      platform: 'instagram',\n      views: views,\n      reach: reach,\n      total_interactions: totalInteractions,\n      likes: likes,\n      comments: comments,\n      shares: shares,\n      saved: saved\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -320,
        1568
