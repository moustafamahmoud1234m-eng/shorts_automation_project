    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const metrics = $json.data || [];\n\nlet videoId = '';\nlet plays = 0;\nlet avgWatchTimeMs = 0;\nlet comments = 0;\nlet reactions = 0;\nlet shares = 0;\n\nfor (const item of metrics) {\n  if (!videoId && item.id) {\n    // Extracts the video ID from \"1925205605552411/video_insights/...\"\n    videoId = item.id.split('/')[0];\n  }\n\n  const firstValue = (item.values && item.values.length > 0) ? item.values[0].value : null;\n\n  switch (item.name) {\n    case 'fb_reels_total_plays':\n      plays = Number(firstValue) || 0;\n      break;\n\n    case 'post_video_avg_time_watched':\n      avgWatchTimeMs = Number(firstValue) || 0;\n      break;\n\n    case 'post_video_social_actions':\n      if (typeof firstValue === 'object' && firstValue !== null) {\n        comments = firstValue.COMMENT || 0;\n        shares = firstValue.SHARE || 0;\n        // Aggregates likes or explicit reaction keys if present\n        reactions = (firstValue.LIKE || 0) + (firstValue.REACTION || 0);\n      }\n      break;\n  }\n}\n\nreturn {\n  json: {\n    video_id: videoId,\n    platform: 'facebook',\n    plays: plays,\n    avg_watch_time_seconds: Number((avgWatchTimeMs / 1000).toFixed(2)),\n    comments: comments,\n    shares: shares,\n    reactions: reactions\n  }\n};"
      },
