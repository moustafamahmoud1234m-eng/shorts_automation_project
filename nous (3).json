    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Task:\nAnalyze the current social media metrics and compare them\nwith the previous two data submissions.\n\nContext:\nCurrent data:\n{{ JSON.stringify($json.current_data) }}\n\nPrevious reports:\n{{ JSON.stringify($json.previous_reports) }}\n\nRole:\nYou are a professional Social Media Performance Analyst.\n\nFormat:\nReturn a JSON object containing:\n{\n  \"subject\": \"Social Media Performance Report\",\n  \"body\": \"Professional email containing verified findings and recommendations.\"\n}\n\nTone:\nProfessional, concise, and analytical.\n\nConstraints:\n- Use only the supplied current and historical data.\n- Compare Instagram, Facebook, and YouTube metrics separately.\n- Match metrics by platform and metric name.\n- Never compare unrelated records or assume their chronological order.\n- Calculate percentage changes only when valid comparable values exist.\n- Never use previous AI-generated emails as historical data.\n- If historical data is unavailable, state this explicitly.\n- Return valid JSON only.",
        "hasOutputParser": true,
        "needsFallback": true,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
