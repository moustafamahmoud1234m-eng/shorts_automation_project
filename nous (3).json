    {
      "parameters": {
        "jsCode": "// Helper to convert ISO 8601 duration (e.g. PT2M28S, PT18S) to total seconds\nfunction parseIsoDuration(durationStr) {\n  if (!durationStr) return 0;\n  const match = durationStr.match(/PT(?:(\\d+)H)?(?:(\\d+)M)?(?:(\\d+)S)?/);\n  if (!match) return 0;\n  const hours = parseInt(match[1] || 0, 10);\n  const minutes = parseInt(match[2] || 0, 10);\n  const seconds = parseInt(match[3] || 0, 10);\n  return (hours * 3600) + (minutes * 60) + seconds;\n}\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  const json = item.json;\n  const snippet = json.snippet || {};\n  const stats = json.statistics || {};\n  const content = json.contentDetails || {};\n\n  results.push({\n    json: {\n      \n      platform: 'youtube',\n      title: snippet.title || '',\n      views: Number(stats.viewCount) || 0,\n      likes: Number(stats.likeCount) || 0,\n      comments: Number(stats.commentCount) || 0,\n      duration_seconds: parseIsoDuration(content.duration),\n    \n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -320,
        1952
      ],
      "id": "4ee6bd26-3d38-4c24-a385-dd1547f3860f",
      "name": "filtering yt"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const metrics = $json.data || [];\n\nlet videoId = '';\nlet plays = 0;\nlet avgWatchTimeMs = 0;\nlet comments = 0;\nlet reactions = 0;\nlet shares = 0;\n\nfor (const item of metrics) {\n  if (!videoId && item.id) {\n    // Extracts the video ID from \"1925205605552411/video_insights/...\"\n    videoId = item.id.split('/')[0];\n  }\n\n  const firstValue = (item.values && item.values.length > 0) ? item.values[0].value : null;\n\n  switch (item.name) {\n    case 'fb_reels_total_plays':\n      plays = Number(firstValue) || 0;\n      break;\n\n    case 'post_video_avg_time_watched':\n      avgWatchTimeMs = Number(firstValue) || 0;\n      break;\n\n    case 'post_video_social_actions':\n      if (typeof firstValue === 'object' && firstValue !== null) {\n        comments = firstValue.COMMENT || 0;\n        shares = firstValue.SHARE || 0;\n        // Aggregates likes or explicit reaction keys if present\n        reactions = (firstValue.LIKE || 0) + (firstValue.REACTION || 0);\n      }\n      break;\n  }\n}\n\nreturn {\n  json: {\n    \n    platform: 'facebook',\n    plays: plays,\n    avg_watch_time_seconds: Number((avgWatchTimeMs / 1000).toFixed(2)),\n    comments: comments,\n    shares: shares,\n    reactions: reactions\n  }\n};"
      },
